DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Image provider: mock | mimo | wanx | qwen
IMAGE_PROVIDER=mock

# Qwen image (DashScope) — qwen-image-3.0
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_SIZE=1024*1024
# sdk | http | openai
QWEN_IMAGE_MODE=sdk
QWEN_IMAGE_NEGATIVE_PROMPT=text, watermark, logo, lowres, blurry, daytime bright sun, pastel colors, white background

# MiMo image API (OpenAI-compatible POST {base}/images/generations)
MIMO_IMAGE_BASE_URL=http://127.0.0.1:7342/v1
MIMO_IMAGE_API_KEY=
MIMO_IMAGE_MODEL=mimo-image
MIMO_IMAGE_SIZE=1024x1024
